        "transitions": {
          "assertions": [
            "context-transition"
          ],
          "kinds": [
            "handoff"
          ],
          "minItems": 2,
          "coversAffectedWork": true
        },
        "missingState": {
          "assertions": [
            "handoff-state-missing"
          ],
          "kinds": [
            "claim",
            "status",
            "validation"
          ],
          "minItems": 1,
          "coversAffectedWork": true
        }
      },
      "relations": [
        {
          "type": "same-subject",
          "roles": [
            "transitions",
            "missingState"
          ]
        },
        {
          "type": "distinct-property",
          "roles": [
            "transitions"
          ],
          "property": "observedAt"
        }
      ]
    },
    "unbounded-work": {
      "roles": {
        "activeWork": {
          "assertions": [
            "work-active"
          ],
          "kinds": [
            "assignment",
            "process",
            "schedule"
          ],
          "states": [
            "active"
          ],
          "minItems": 1,
          "coversAffectedWork": true
        },
        "missingBound": {
          "assertions": [
            "execution-bound-missing"
          ],
          "kinds": [
            "budget",
            "elapsed-time",
            "process",
            "schedule"
          ],
          "minItems": 1,
          "coversAffectedWork": true
        }
      },
      "relations": []
    }
  },
  "required": [
    "schemaVersion",
    "snapshot",
    "currentWorkInventory",
    "findings",
    "findingAudits",
    "repeatedFailureClusters",
    "correction",
    "validationPlan",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "snapshot": {
      "$ref": "#/$defs/snapshotReference"
    },
    "currentWorkInventory": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/currentWorkInventoryItem"
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "findingAudits": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/findingAudit"
      }
    },
    "repeatedFailureClusters": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/repeatedFailureCluster"
      }
    },
    "correction": {
      "$ref": "#/$defs/correction"
    },
    "validationPlan": {
      "$ref": "#/$defs/validationPlan"
    },
    "status": {
      "$ref": "#/$defs/reportStatus"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "roleName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "fingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "text4096": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "text2048": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "text1024": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "timestamp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "identifierList128": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "nonEmptyIdentifierList128": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "textList32": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text1024"
      }
    },
    "nonEmptyTextList32": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text1024"
      }
    },
    "validationPlan": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text1024"
      }
    },
    "snapshotReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotId",
        "bindingDigest",
        "goalRevision",
        "manifestRevision",
        "fleetRevision",
        "repositoryRevision",
        "observedAt",
        "completeness"
      ],
      "properties": {
        "snapshotId": {
          "$ref": "#/$defs/identifier"
        },
        "bindingDigest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "goalRevision": {
          "$ref": "#/$defs/identifier"
        },
        "manifestRevision": {
          "$ref": "#/$defs/identifier"
        },
        "fleetRevision": {
          "$ref": "#/$defs/identifier"
        },
        "repositoryRevision": {
          "$ref": "#/$defs/identifier"
        },
        "observedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "completeness": {
          "enum": [
            "complete",
            "partial"
          ]
        }
      }
    },
    "workState": {
      "enum": [
        "active",
        "queued",
        "blocked",
        "terminal",
        "unverified"
      ]
    },
    "currentWorkInventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workId",
        "state",
        "evidenceAnchors"
      ],
      "properties": {
        "workId": {
          "$ref": "#/$defs/identifier"
        },
        "state": {
          "$ref": "#/$defs/workState"
        },
        "evidenceAnchors": {
          "$ref": "#/$defs/nonEmptyIdentifierList128"
        }
      }
    },
    "category": {
      "enum": [
        "shared-root-local-remediation",
        "duplicate-investigation",
        "duplicate-implementation",
        "stale-worker",
        "stale-readiness",
        "retry-without-new-evidence",
        "out-of-manifest-work",
        "goal-drift",
        "premature-abstraction",
        "premature-optimization",
        "authority-escalation",
        "human-interruption-noise",
        "ownership-race",
        "hallucinated-state",
        "evidence-laundering",
        "privacy-boundary-breach",
        "context-churn",
        "unbounded-work"
      ]
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "privacyHandling": {
      "enum": [
        "not-applicable",
        "anchors-only-redacted"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Binding relational rule: confidence high is valid only when every sealed-snapshot observation named by evidenceAnchors has completeness complete. Any partial anchored observation requires medium or low confidence.",
      "required": [
        "id",
        "category",
        "severity",
        "evidenceAnchors",
        "affectedWork",
        "consequence",
        "confidence",
        "disconfirmingEvidence",
        "rootCorrection",
        "localActionsToStop",
        "validation",
        "privacyHandling"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "evidenceAnchors": {
          "$ref": "#/$defs/nonEmptyIdentifierList128"
        },
        "affectedWork": {
          "$ref": "#/$defs/nonEmptyIdentifierList128"
        },
        "consequence": {
          "$ref": "#/$defs/text4096"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "disconfirmingEvidence": {
          "$ref": "#/$defs/identifierList128"
        },
        "rootCorrection": {
          "$ref": "#/$defs/text4096"
        },
        "localActionsToStop": {
          "$ref": "#/$defs/textList32"
        },
        "validation": {
          "$ref": "#/$defs/nonEmptyTextList32"
        },
        "privacyHandling": {
          "$ref": "#/$defs/privacyHandling"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "privacy-boundary-breach"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "privacyHandling": {
                "const": "anchors-only-redacted"
              }
            }
          },
          "else": {
            "properties": {
              "privacyHandling": {
                "const": "not-applicable"
              }
            }
          }
        }
      ]
    },
    "evidenceRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "observationIds"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/roleName"
        },
        "observationIds": {
          "$ref": "#/$defs/nonEmptyIdentifierList128"
        }
      }
    },
    "findingAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingId",
        "category",
        "evidenceRoles"
      ],
      "properties": {
        "findingId": {
          "$ref": "#/$defs/identifier"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "evidenceRoles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/evidenceRole"
          }
        }
      }
    },
    "repeatedFailureCluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "affectedWork",
        "evidenceAnchors"
      ],
      "properties": {
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "affectedWork": {
          "$ref": "#/$defs/nonEmptyIdentifierList128"
        },
        "evidenceAnchors": {
          "$ref": "#/$defs/nonEmptyIdentifierList128"
        }
      }
    },
    "correctionStrategy": {
      "enum": [
        "continue",
        "pause-wave",
        "deduplicate",
        "root-cause-first",
        "return-to-goal",
        "replace-worker",
        "refresh-evidence",
        "human-decision",
        "post-mortem",
        "blocked"
      ]
    },
    "parentDirectiveAction": {
      "enum": [
        "stop-new-dispatch",
        "pause-cross-boundary-publication",
        "mark-readiness-stale",
        "deduplicate-queued-retries",
        "prevent-conflicting-assignment",
        "consolidate-shared-root-investigation",
        "request-verified-handoff",
        "lower-status-to-unverified",
        "route-routine-engineering-to-parent",
        "preserve-active-atomic-operations",
        "preserve-evidence",
        "request-fresh-observation"
      ]
    },
    "humanDecision": {
      "enum": [
        "change-approved-manifest",
        "reassign-ownership",
        "modify-code",
        "mutate-tracker-or-change-request",
        "delete-branch-worktree-or-artifact",
        "stop-process-or-cancel-schedule",
        "accept-risk",
        "remediate-privacy-incident",
        "change-product-direction",
        "change-architecture",
        "change-scope-or-priority"
      ]
    },
    "parentDirective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "targets",
        "rationale",
        "findingIds"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/parentDirectiveAction"
        },
        "targets": {
          "$ref": "#/$defs/nonEmptyIdentifierList128",
          "$comment": "Binding relational rule: every target must be a validator-derived work identity from either affectedWork on a finding named by this directive or currentWorkInventory. Evidence-anchor and subject identities are not directive targets."
        },
        "rationale": {
          "$ref": "#/$defs/text2048"
        },
        "findingIds": {
          "$ref": "#/$defs/identifierList128"
        }
      }
    },
    "humanDecisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "rationale",
        "findingIds"
      ],
      "properties": {
        "decision": {
          "$ref": "#/$defs/humanDecision"
        },
        "rationale": {
          "$ref": "#/$defs/text2048"
        },
        "findingIds": {
          "$ref": "#/$defs/identifierList128"
        }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "authority",
        "findingIds",
        "parentDirectives",
        "humanDecisions",
        "validation"
      ],
      "properties": {
        "strategy": {
          "$ref": "#/$defs/correctionStrategy"
        },
        "authority": {
          "const": "parent-only"
        },
        "findingIds": {
          "$ref": "#/$defs/identifierList128",
          "$comment": "Binding relational rule: correction.findingIds must contain all and only the identities in the top-level findings array."
        },
        "parentDirectives": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/parentDirective"
          }
        },
        "humanDecisions": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/humanDecisionRequest"
          }
        },
        "validation": {
          "$ref": "#/$defs/nonEmptyTextList32"
        }
      }
    },
    "reportStatus": {
      "enum": [
        "clean",
        "slop-detected",
        "pause-recommended",
        "human-decision-required",
        "insufficient-evidence",
        "blocked"
      ]
    }
  }
}
