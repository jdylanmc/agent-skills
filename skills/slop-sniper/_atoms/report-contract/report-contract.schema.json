{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jdylanmc/agent-skills/skills/slop-sniper/report-contract.schema.json",
  "title": "Slop Sniper canonical report",
  "description": "The complete prompt-facing report contract. Standard JSON Schema keywords define structure and bounds. Every $comment, description, and x- section is binding; relational annotations are consumed directly by the validator when standard JSON Schema cannot express a snapshot-derived rule.",
  "type": "object",
  "additionalProperties": false,
  "x-maxUtf8Bytes": 524288,
  "x-specialistPromptBinding": {
    "personaPath": "agents/slop-sniper.agent.md",
    "personaSha256": "96870aa8f1f8589958b9fdce5af37ba2abfd4c20583399e8b7b13c834f8017f3",
    "reportSchemaPath": "skills/slop-sniper/_atoms/report-contract/report-contract.schema.json"
  },
  "x-relationalRules": {
    "highConfidenceEvidenceCompleteness": "complete",
    "correctionFindingIds": "exactly-all-findings",
    "directiveTargetSources": [
      "referenced-finding-affected-work",
      "current-work-inventory"
    ]
  },
  "x-outcomeRules": {
    "statusesRequiringFindings": [
      "slop-detected",
      "pause-recommended",
      "human-decision-required"
    ],
    "strategyStatuses": {
      "continue": [
        "clean"
      ],
      "pause-wave": [
        "pause-recommended"
      ],
      "human-decision": [
        "human-decision-required"
      ],
      "blocked": [
        "insufficient-evidence",
        "blocked"
      ]
    },
    "clean": {
      "snapshotCompleteness": "complete",
      "findingCount": 0,
      "strategy": "continue",
      "parentDirectiveCount": 0,
      "humanDecisionCount": 0
    },
    "humanDecisions": {
      "status": "human-decision-required",
      "nonEmptyIfAndOnlyIfStatus": true
    },
    "criticalFindingStatuses": [
      "pause-recommended",
      "human-decision-required"
    ],
    "privacyFinding": {
      "status": "human-decision-required",
      "strategy": "human-decision",
      "parentDirective": "pause-cross-boundary-publication",
      "humanDecision": "remediate-privacy-incident"
    }
  },
  "x-findingAuditRules": {
    "exactlyOnePerFinding": true,
    "categoryMustMatch": true,
    "requiredRolesMustMatchCategory": true,
    "allAndOnlyFindingEvidenceAnchors": true
  },
  "x-repeatedFailureClusterRules": {
    "anchorsAreMatchingFailuresOnly": true,
    "affectedWorkIsFailureWorkUnion": true,
    "sharedRootClusterMatchesFindingExactly": true
  },
